# ---------------------------------------------------------------------------
# Root environment template. Copy to .env and adjust before running.
# The server and client packages read these values via dotenv.
# ---------------------------------------------------------------------------

# Server
PORT=4000
DATABASE_URL=postgresql://bidwhist:bidwhist@localhost:5432/bidwhist?schema=public
JWT_SECRET=please-change-me-before-deploying
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# Per-bot action delay range (ms) used to mimic human timing.
BOT_MIN_DELAY_MS=400
BOT_MAX_DELAY_MS=1200
# When a human disconnects mid-game, let a deterministic bot hold their seat.
AUTO_BOT_TAKEOVER=true

# Client
# Leave empty to use the same origin (Vite proxies /api and /socket.io to the server).
VITE_API_BASE_URL=
VITE_SOCKET_URL=
