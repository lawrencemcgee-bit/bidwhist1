{
  "name": "bidwhist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real-time multiplayer Classic Partnership Bid Whist",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev -w @bidwhist/server",
    "dev:client": "npm run dev -w @bidwhist/client",
    "build": "npm run build -w @bidwhist/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @bidwhist/server",
    "db:migrate": "npm run db:migrate -w @bidwhist/server",
    "db:deploy": "npm run db:deploy -w @bidwhist/server",
    "db:seed": "npm run db:seed -w @bidwhist/server"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
